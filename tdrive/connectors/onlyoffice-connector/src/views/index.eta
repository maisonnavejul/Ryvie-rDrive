<!DOCTYPE html>
<html>

<head>
  <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.0/jquery.min.js"></script>
  <script type="text/javascript" src="<%= it.onlyoffice_server %>web-apps/apps/api/documents/api.js"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no,shrink-to-fit=no" />
  <title>rDrive</title>
</head>

<body style="height: 100%">
  <div id="onlyoffice_container" style="top: 0; left: 0; width: 100%; height: 100%; position: absolute; color: #fff; text-align: center; background-color: <%= it.color %>"></div>
  <script type="text/javascript">
    $(document).ready(function() {
      window.user = {
        id: "<%= it.user_id %>",
        username: "<%= it.username %>",
        language: "<%= it.language %>",
        userimage: "<%= it.user_image %>"
      };
      window.mode = "<%= it.mode %>"
      // baseURL : appels NAVIGATEUR -> connecteur (same-origin), ex: rename
      window.baseURL = `<%= it.server %>/${window.mode}/`;
      // dsBaseURL : URLs consommées par le DOCUMENT SERVER (read + callback) -> URL interne robuste
      window.dsBaseURL = `<%= it.ds_server %>/${window.mode}/`;

      $('#onlyoffice_container').html("<div id='onlyoffice_container_instance'></div>");

      const callbackQueryString = '?drive_file_id=<%= it.drive_file_id %>&company_id=<%= it.company_id %>&token=<%= it.token %>';
      let doc = {
        title: "<%= it.filename %>",
        url: `${window.dsBaseURL}read${callbackQueryString}`,
        fileType: "<%= it.file_type %>",
        key: "<%= it.docId %>",
        permissions: {
          download: true,
          edit: <%= it.editable %>,
          preview: <%= it.preview %>,
        }
      }
      function updateTitle(title) {
        const el = document.querySelector('head title');
        if (el) el.innerText = title + ' — rDrive';
      }
      updateTitle(doc.title);

      // Track connection state for reconnection
      window._ooConnectionLost = false;
      window._ooLastError = null;

      function showReconnectBanner() {
        if (document.getElementById('oo-reconnect-banner')) return;
        var banner = document.createElement('div');
        banner.id = 'oo-reconnect-banner';
        banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#ef4444;color:#fff;text-align:center;padding:12px 16px;font-family:system-ui,sans-serif;font-size:14px;display:flex;align-items:center;justify-content:center;gap:12px;box-shadow:0 2px 8px rgba(0,0,0,.2)';
        banner.innerHTML = '<span>⚠️ La connexion au document a été perdue.</span><button id="oo-reload-btn" style="background:#fff;color:#ef4444;border:none;padding:6px 16px;border-radius:6px;font-weight:600;cursor:pointer;font-size:14px">Recharger</button>';
        document.body.appendChild(banner);
        document.getElementById('oo-reload-btn').addEventListener('click', function() {
          window.location.reload();
        });
      }

      function removeReconnectBanner() {
        var banner = document.getElementById('oo-reconnect-banner');
        if (banner) banner.remove();
      }

      // Detect when user returns to the tab after being away
      document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible' && window._ooConnectionLost) {
          // Connection was lost while away — auto reload
          window.location.reload();
        }
      });

      window.docEditor = new DocsAPI.DocEditor('onlyoffice_container_instance', {
        scrollSensitivity: window.mode === 'text' ? 100 : 40,
        width: '100%',
        height: '100%',
        documentType: window.mode,
        document: doc,
        type: screen.width < 600 ? 'mobile' : 'desktop',
        events: {
          onRequestRename: function (event) {
            let name = event.data;
            const prevExtension = /\.[^.]+$/.exec(doc.title);
            if (prevExtension) name += prevExtension[0];
            $.
            post(`${window.baseURL}rename${callbackQueryString}`, { name }).
            done((changed) => {
              if (changed.name != name)
                window.docEditor.showMessage(`✅ Renamed to: ${changed.name}`);
            }).
            fail(() => window.docEditor.showMessage('🚨 Error renaming the file'));
          },
          onMetaChange: function (event) {
            const { title } = event.data;
            if (title) updateTitle(title);
          },
          onError: function (event) {
            console.error('OnlyOffice error:', event.data);
            window._ooConnectionLost = true;
            window._ooLastError = event.data;
            showReconnectBanner();
          },
          onWarning: function (event) {
            console.warn('OnlyOffice warning:', event.data);
            // errorCode -80 = connection lost
            if (event.data && event.data.warningCode === -80) {
              window._ooConnectionLost = true;
              showReconnectBanner();
            }
          },
        },
        editorConfig: {
          callbackUrl: `${window.dsBaseURL}callback${callbackQueryString}`,
          lang: window.user.language,
          user: {
            id: window.user.id,
            name: window.user.username,
          },
          customization: {
            chat: false,
            compactToolbar: false,
            about: false,
            feedback: false,
            forcesave: true,
            goback: {
              text: '',
              blank: false,
              url: '#',
            },
          },
        },
      });

    });
  </script>
</body>

</html>
