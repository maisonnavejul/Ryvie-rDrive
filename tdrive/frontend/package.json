  "name": "tdrive",
  "version": "2020.3.107",
  "repository": "https://github.com/Tdrive/Tdrive",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite",
    "dev:prettier": "prettier --write src/",
    "dev:linter": "eslint src/",
    "start": "vite",
    "build": "vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "build-storybook": "build-storybook -o public/storybook",
    "storybook": "concurrently \"start-storybook -p 6006 -s public\" \"npx tailwindcss -i ./src/tailwind.css -o ./public/styles/tailwind.css --watch\""
  },
  "eslintConfig": {
    "extends": "eslint-config-react-app-eslint-six",
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ],
    "plugins": [
      "syntax-trailing-function-commas"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "less",
      "core-js",
      "core-js-pure"
    ]
